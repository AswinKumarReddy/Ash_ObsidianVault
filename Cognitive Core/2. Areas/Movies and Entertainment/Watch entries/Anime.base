filters:
  and:
    - 'file.inFolder("2. Areas/Movies and Entertainment/Watch entries/Anime Entries")'
    - 'type == "anime_watch_entry"'
properties:
  file.name:
    displayName: Anime
  status:
    displayName: Status
  priority:
    displayName: Priority
  rating:
    displayName: Rating
  finished:
    displayName: Finished
  notes:
    displayName: Notes
views:
  - type: table
    name: "To Watch"
    filters:
      and:
        - 'status != "done"'
    order:
      - file.name
      - status
      - priority
      - rating
      - finished
      - notes
  - type: table
    name: "Completed"
    filters:
      and:
        - 'status == "done"'
    order:
      - file.name
      - rating
      - finished
      - notes
  - type: table
    name: "All Anime"
    order:
      - file.name
      - status
      - priority
      - rating
      - finished
      - notes
